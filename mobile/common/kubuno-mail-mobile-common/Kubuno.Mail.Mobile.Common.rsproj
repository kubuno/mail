<Project Sdk="Kubuno.Rust.Sdk/1.1.1">

  <!-- Kubuno Mail for mobile, the app, portable: the .kbview screens (views/). It belongs to the mobile workspace
       ..\..\Cargo.toml (mobile/); it is a portable library, so it builds at package scope. This file is yours: it is
       never overwritten by a later run of the solution generator - edit it freely. -->
  <PropertyGroup>
    <CargoPackage>kubuno-mail-mobile-common</CargoPackage>
  </PropertyGroup>

</Project>
