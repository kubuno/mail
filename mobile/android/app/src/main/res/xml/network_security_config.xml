<?xml version="1.0" encoding="utf-8"?>
<!-- Self-hosted instances commonly use private CAs: trust user-installed
     certificates in addition to the system store (Android ignores user CAs
     by default since API 24). Cleartext stays disabled. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
